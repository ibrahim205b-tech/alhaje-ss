 "captions": [
  {
   "start": 3.9,
   "end": 4.815,
   "text": "اسمي رقيّة…",
   "hidden": false
  },
  {
   "start": 4.942,
   "end": 7.569,
   "text": "عمري واحدٌ وعشرون عاماً، من كربلاء.",
   "hidden": false
  },
  {
   "start": 7.87,
   "end": 8.844,
   "text": "أحبُّ التصوير.",
   "hidden": false
  },
  {
   "start": 9.244,
   "end": 12.024,
   "text": "كنتُ أصوّر الورد، والشجر، وضوء المساء.",
   "hidden": false
  },
  {
   "start": 12.384,
   "end": 13.46,
   "text": "ثمّ صارت صوري…",
   "hidden": false
  },
  {
   "start": 13.46,
   "end": 15.918,
   "text": "ممرّات المستشفى، وأكياس العلاج.",
   "hidden": false
  },
  {
   "start": 16.418,
   "end": 17.901,
   "text": "أُصبتُ بسرطان العظام.",
   "hidden": false
  },
  {
   "start": 18.101,
   "end": 20.101,
   "text": "استأصلوا جزءاً من عظام حوضي،",
   "hidden": false
  },
  {
   "start": 20.118,
   "end": 23.338,
   "text": "وتحمّلتُ إحدى عشرة جرعةً من العلاج الكيميائي.",
   "hidden": false
  },
  {
   "start": 23.838,
   "end": 25.194,
   "text": "لكنّ الفحص الأخير…",
   "hidden": false
  },
  {
   "start": 25.279,
   "end": 27.482,
   "text": "أظهرَ أنّ المرض ما زال يتقدّم.",
   "hidden": false
  },
  {
   "start": 28.532,
   "end": 30.185,
   "text": "أنا لا أطلبُ المستحيل…",
   "hidden": true
  },
  {
   "start": 30.305,
   "end": 32.271,
   "text": "أطلبُ فرصةً أخرى للحياة.",
   "hidden": true
  },
  {
   "start": 32.651,
   "end": 34.625,
   "text": "ما زلتُ متمسّكةً بالأمل…",
   "hidden": false
  },
  {
   "start": 34.625,
   "end": 37.142,
   "text": "وأؤمن أنّ الفرج قد يأتي على أيدي الناس.",
   "hidden": false
  },
  {
   "start": 37.642,
   "end": 40.591,
   "text": "قصّتي كاملة في الرابط الموجود في صفحتي.",
   "hidden": false
  },
  {
   "start": 40.811,
   "end": 42.871,
   "text": "وإن لم تستطع أن تساعدني…",
   "hidden": false
  },
  {
   "start": 42.913,
   "end": 45.159,
   "text": "فلا تجعل قصّتي تتوقّف عندك.",
   "hidden": true
  }
 ],
