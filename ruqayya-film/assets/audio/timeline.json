 "captions": [
  {
   "start": 3.9,
   "end": 4.882,
   "text": "اسمي رقيّة…",
   "hidden": false
  },
  {
   "start": 5.018,
   "end": 7.836,
   "text": "عمري واحدٌ وعشرون عاماً، من كربلاء.",
   "hidden": false
  },
  {
   "start": 8.136,
   "end": 9.182,
   "text": "أحبُّ التصوير.",
   "hidden": false
  },
  {
   "start": 9.582,
   "end": 12.564,
   "text": "كنتُ أصوّر الورد، والشجر، وضوء المساء.",
   "hidden": false
  },
  {
   "start": 12.924,
   "end": 14.078,
   "text": "ثمّ صارت صوري…",
   "hidden": false
  },
  {
   "start": 14.078,
   "end": 16.715,
   "text": "ممرّات المستشفى، وأكياس العلاج.",
   "hidden": false
  },
  {
   "start": 17.215,
   "end": 18.805,
   "text": "أُصبتُ بسرطان العظام.",
   "hidden": false
  },
  {
   "start": 19.005,
   "end": 21.151,
   "text": "استأصلوا جزءاً من عظام حوضي،",
   "hidden": false
  },
  {
   "start": 21.169,
   "end": 24.624,
   "text": "وتحمّلتُ إحدى عشرة جرعةً من العلاج الكيميائي.",
   "hidden": false
  },
  {
   "start": 25.124,
   "end": 26.578,
   "text": "لكنّ الفحص الأخير…",
   "hidden": false
  },
  {
   "start": 26.669,
   "end": 29.033,
   "text": "أظهرَ أنّ المرض ما زال يتقدّم.",
   "hidden": false
  },
  {
   "start": 30.083,
   "end": 31.855,
   "text": "أنا لا أطلبُ المستحيل…",
   "hidden": true
  },
  {
   "start": 31.975,
   "end": 34.085,
   "text": "أطلبُ فرصةً أخرى للحياة.",
   "hidden": true
  },
  {
   "start": 34.465,
   "end": 36.583,
   "text": "ما زلتُ متمسّكةً بالأمل…",
   "hidden": false
  },
  {
   "start": 36.583,
   "end": 39.283,
   "text": "وأؤمن أنّ الفرج قد يأتي على أيدي الناس.",
   "hidden": false
  },
  {
   "start": 39.783,
   "end": 42.946,
   "text": "قصّتي كاملة في الرابط الموجود في صفحتي.",
   "hidden": false
  },
  {
   "start": 43.166,
   "end": 45.375,
   "text": "وإن لم تستطع أن تساعدني…",
   "hidden": false
  },
  {
   "start": 45.421,
   "end": 47.83,
   "text": "فلا تجعل قصّتي تتوقّف عندك.",
   "hidden": true
  }
 ],
